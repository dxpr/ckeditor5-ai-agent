msgctxt ""
"Tooltip displayed when hovering over the CKEditor 5 icon, providing "
"information about AI assistance."
msgid "Ai agent"
msgstr "وكيل الذكاء الاصطناعي"

msgctxt "Hint suggesting users utilize AI for documenting or content creation."
msgid "Type / to request AI content"
msgstr "اكتب / لطلب محتوى الذكاء الاصطناعي"

msgctxt "Appears when the Browser does not support readable streams."
msgid "Browser does not support readable streams"
msgstr "المتصفح لا يدعم التدفقات القابلة للقراءة"

msgctxt "Indicates a failure when processing the provided prompt."
msgid "Oops! Something went wrong while processing your request"
msgstr "عذرًا! حدث خطأ أثناء معالجة طلبك"

msgctxt "Indicates an error when unable to parse the AI response stream."
msgid "An error occurred while handling the AI's response"
msgstr "حدث خطأ أثناء معالجة استجابة الذكاء الاصطناعي"

msgctxt "Indicates a failure during a network call."
msgid "We couldn't connect to the AI. Please check your internet"
msgstr "لم نتمكن من الاتصال بالذكاء الاصطناعي. يرجى التحقق من اتصال الإنترنت لديك"

msgctxt "Appears when an unsupported language code is provided."
msgid "Unsupported language code"
msgstr "رمز اللغة غير مدعوم"

msgctxt "Appears when jina reader fails to fetch url content"
msgid "Failed to fetch content of : %0"
msgstr "فشل في جلب محتوى: %0"